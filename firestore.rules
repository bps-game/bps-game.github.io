rules_version = '2';

// Règles de sécurité pour l'outil de contribution/modération des questions
// (editor.html, mode "en ligne"). Le jeu multijoueur lui-même ne touche
// jamais à cette base : il continue de lire questions/questions.json en
// statique. Cette base sert uniquement à proposer/valider de nouvelles
// questions avant qu'elles soient exportées dans ce fichier.
//
// À coller tel quel dans Firebase Console → Firestore Database → Règles.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return isSignedIn() ? request.auth.token.email.lower() : "";
    }

    // Le super-admin est codé EN DUR ici, directement dans les règles.
    // Seule une personne ayant accès à cette console Firebase peut changer
    // cette adresse — même pas l'app elle-même. Il n'a besoin d'aucun
    // document dans /admins pour être reconnu comme admin : c'est
    // automatique dès sa connexion, et c'est lui seul qui peut ajouter ou
    // retirer d'autres admins (voir plus bas).
    function isSuperAdmin() {
      return myEmail() == "advestankv@gmail.com";
    }

    // Être admin = être le super-admin, OU avoir un document dans /admins
    // dont l'ID est son adresse email en minuscules (ajouté par le
    // super-admin depuis l'app, voir js/admins.js).
    function isAdmin() {
      return isSuperAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(myEmail())));
    }

    // Admins ajoutés par le super-admin (en plus de lui-même, qui n'a pas
    // besoin d'entrée ici). Lisible par tout compte connecté (transparence) ;
    // seul le super-admin peut en ajouter/retirer, et uniquement avec un ID
    // de document déjà en minuscules (cohérence avec myEmail()).
    match /admins/{emailId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() && emailId == emailId.lower();
    }

    // Pseudo public choisi par chaque compte (affiché à la place du nom/email
    // Google) : un document par utilisateur, lisible et modifiable
    // uniquement par son propriétaire.
    match /profiles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.size() > 0
        && request.resource.data.pseudo.size() <= 24;
    }

    // Questions proposées par la communauté, en attente de modération.
    match /proposals/{proposalId} {
      // Tout compte connecté voit la file d'attente (transparence).
      allow read: if isSignedIn();

      // Créer une proposition : uniquement en son propre nom, forcément
      // "pending" au départ (impossible de s'auto-approuver), avec un
      // minimum de forme valide. La validation complète du schéma se fait
      // côté client (js/questions.js) avant l'envoi.
      allow create: if isSignedIn()
        && request.resource.data.proposedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.question is map
        && request.resource.data.question.question is string
        && request.resource.data.question.acceptableAnswers is list
        && request.resource.data.question.acceptableAnswers.size() > 0;

      // Un admin peut changer le statut (approuver/rejeter), mais ne peut
      // pas réécrire le contenu de la question au passage — défense en
      // profondeur, même si l'interface ne le propose jamais.
      allow update: if isAdmin()
        && request.resource.data.question == resource.data.question
        && request.resource.data.proposedBy == resource.data.proposedBy
        && request.resource.data.status in ['approved', 'rejected', 'pending'];

      // L'auteur peut retirer sa propre proposition tant qu'elle attend une
      // décision ; un admin peut supprimer n'importe quelle proposition.
      allow delete: if isAdmin()
        || (isSignedIn()
            && resource.data.proposedBy == request.auth.uid
            && resource.data.status == 'pending');
    }
  }
}
